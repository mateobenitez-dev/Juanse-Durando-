---
import Base from '../layouts/Base.astro';
import Intro from '../components/Intro.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import logo from '../components/logo.svg?raw';
import { site, isSet, whatsappLink } from '../data/site';

// Slider tipo historias de Instagram, con la sesión de estudio
const slides = [
  { name: 'slide-auriculares', alt: 'Juanse Durando poniéndose los auriculares' },
  { name: 'slide-anteojos', alt: 'Juanse Durando con anteojos de sol' },
  { name: 'slide-dramatica', alt: 'Retrato de Juanse Durando con luz lateral' },
  { name: 'slide-brazos', alt: 'Juanse Durando de brazos cruzados' },
  { name: 'slide-espaldas', alt: 'Juanse Durando de espaldas con auriculares' },
];

const reels = [
  { src: 'video/reel-fiesta-u.mp4', poster: 'img/reel-poster.jpg', label: 'Juanse Durando en Fiesta U' },
  { src: 'video/reel-cabina.mp4', poster: 'img/reel-cabina-poster.jpg', label: 'Juanse Durando en cabina' },
];

// Galería de shows: "big" ocupa dos filas
const galeria = [
  { src: 'img/vivo-escenario-900.webp', alt: 'Juanse Durando en escenario con su logo de fondo', big: true },
  { src: 'img/vivo-azul-900.webp', alt: 'Juanse Durando pasando música con luces azules' },
  { src: 'img/vivo-fiesta-u-640.webp', alt: 'Juanse Durando en Fiesta U, Santa Fe' },
  { src: 'img/vivo-gorra-900.webp', alt: 'Juanse Durando con gorra y auriculares' },
  { src: 'img/vivo-controlador-900.webp', alt: 'Juanse Durando en el controlador' },
  { src: 'img/vivo-xv-900.webp', alt: 'Juanse Durando tocando en un cumpleaños de 15' },
  { src: 'img/vivo-aire-libre-900.webp', alt: 'Juanse Durando en un evento al aire libre', big: true },
  { src: 'img/vivo-cabina-900.webp', alt: 'Juanse Durando en cabina' },
  { src: 'img/vivo-bn-900.webp', alt: 'Juanse Durando en blanco y negro' },
  { src: 'img/vivo-gorra2-900.webp', alt: 'Primer plano de Juanse Durando con gorra' },
];
---

<Base>
  <Intro />
  <Header />

  <main id="top">
    <section class="hero" data-hero>
      <div class="hero__media" data-hero-media>
        <img
          src="img/hero-1600.webp"
          srcset="img/hero-800.webp 800w, img/hero-1600.webp 1600w"
          sizes="100vw"
          alt="Juanse Durando con auriculares, retrato de estudio"
          fetchpriority="high"
        />
      </div>
      <div class="hero__shade" aria-hidden="true"></div>
      <div class="hero__content">
        <h1 class="hero__title">
          <span class="sr-only">Juanse Durando, DJ en Santa Fe, Argentina</span>
          <span class="hero__logo" data-hero-logo aria-hidden="true" set:html={logo} />
        </h1>
        <div class="hero__actions" data-hero-line>
          <a class="icon-btn icon-btn--big icon-btn--accent" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Contratar por WhatsApp" data-magnetic>
            <Icon name="whatsapp" />
          </a>
          {isSet(site.socials.instagram) && (
            <a class="icon-btn icon-btn--big" href={site.socials.instagram} target="_blank" rel="noopener" aria-label="Instagram de Juanse Durando" data-magnetic>
              <Icon name="instagram" />
            </a>
          )}
        </div>
      </div>
      <div class="hero__scroll" data-hero-line aria-hidden="true"><span></span></div>
    </section>

    <section class="stories" aria-label="Fotos de Juanse Durando" data-stories>
      <div class="stories__bars" aria-hidden="true">
        {slides.map(() => <span><i></i></span>)}
      </div>
      {slides.map((s, i) => (
        <figure class:list={['stories__slide', { 'is-active': i === 0 }]}>
          <img
            src={`img/${s.name}-1200.webp`}
            srcset={`img/${s.name}-800.webp 800w, img/${s.name}-1200.webp 1200w`}
            sizes="(min-width: 900px) 50vw, 100vw"
            alt={s.alt}
            loading="lazy"
          />
        </figure>
      ))}
      <button class="stories__nav stories__nav--prev" type="button" aria-label="Foto anterior" data-stories-prev></button>
      <button class="stories__nav stories__nav--next" type="button" aria-label="Foto siguiente" data-stories-next></button>
    </section>

    <section class="reels" aria-label="Videos de Juanse Durando en vivo">
      <div class="reels__track">
        {reels.map((r) => (
          <div class="reel" data-reveal>
            <video src={r.src} poster={r.poster} muted loop playsinline preload="none" aria-label={r.label} data-autoplay></video>
            <button class="reel__sound" type="button" aria-label="Activar sonido" data-sound>
              <span class="reel__off"><Icon name="sound-off" /></span>
              <span class="reel__on"><Icon name="sound-on" /></span>
            </button>
          </div>
        ))}
      </div>
    </section>

    <section class="galeria" aria-label="Fotos en vivo">
      {galeria.map((g) => (
        <figure class:list={['galeria__item', { 'galeria__item--big': g.big }]} data-reveal-img>
          <img src={g.src} alt={g.alt} loading="lazy" />
        </figure>
      ))}
    </section>

    <section class="contacto" id="contacto" aria-label="Contrataciones">
      <div class="contacto__media" data-contact-media>
        <img src="img/contacto-1200.webp" srcset="img/contacto-800.webp 800w, img/contacto-1200.webp 1200w" sizes="100vw" alt="Juanse Durando sentado sobre su flightcase" loading="lazy" />
      </div>
      <div class="contacto__shade" aria-hidden="true"></div>
      <div class="contacto__content">
        <div class="contacto__logo" set:html={logo} aria-hidden="true" />
        <div class="contacto__actions" data-reveal>
          <a class="icon-btn icon-btn--xl icon-btn--accent" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Contratar por WhatsApp" data-magnetic>
            <Icon name="whatsapp" />
          </a>
          {isSet(site.socials.instagram) && (
            <a class="icon-btn icon-btn--xl" href={site.socials.instagram} target="_blank" rel="noopener" aria-label="Instagram de Juanse Durando" data-magnetic>
              <Icon name="instagram" />
            </a>
          )}
        </div>
      </div>
    </section>
  </main>

  <a class="contratar-float" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Contrataciones por WhatsApp">
    <Icon name="whatsapp" />
    Contrataciones
  </a>

  <footer class="footer">
    <span>Santa Fe · AR</span>
    <span>© {new Date().getFullYear()}</span>
  </footer>

  <script>
    import '../scripts/main';
  </script>
</Base>
