---
import logo from './logo.svg?raw';
import Icon from './Icon.astro';
import { site, isSet, whatsappLink } from '../data/site';
---

<header class="header" data-header>
  <a href="#top" class="header__logo" aria-label="Juanse Durando, inicio" set:html={logo} />
  <div class="header__icons">
    {isSet(site.socials.instagram) && (
      <a class="icon-btn" href={site.socials.instagram} target="_blank" rel="noopener" aria-label="Instagram de Juanse Durando">
        <Icon name="instagram" />
      </a>
    )}
    <a class="icon-btn icon-btn--accent" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Contratar por WhatsApp" data-magnetic>
      <Icon name="whatsapp" />
    </a>
  </div>
</header>
